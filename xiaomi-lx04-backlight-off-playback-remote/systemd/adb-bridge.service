[Unit]
Description=ADB Bridge - HTTP remote control for Android speaker (media keys / open app / screen-off playback)
After=network.target

[Service]
Type=simple
# 按实际安装路径修改 ExecStart 和 WorkingDirectory
ExecStart=/usr/bin/python3 /opt/adb-bridge/adb-bridge.py
WorkingDirectory=/opt/adb-bridge
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
